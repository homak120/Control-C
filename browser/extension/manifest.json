{
  "manifest_version": 3,
  "name": "Control-C Browser Bridge",
  "version": "0.1.0",
  "description": "Lets local agents (any MCP client, scripts, the Control-C hub) drive tabs in their own tab groups.",
  "minimum_chrome_version": "116",
  "key": "",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["debugger", "tabs", "tabGroups", "scripting", "nativeMessaging", "storage", "alarms"],
  "host_permissions": ["<all_urls>"]
}
